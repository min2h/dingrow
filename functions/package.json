{
  "name": "dingrow-functions",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test lib/test/*.test.js",
    "test:rules": "tsc && cd .. && firebase emulators:exec --project demo-dingrow --only firestore \"cd functions && node --test 'lib/test-emulator/*.test.js'\"",
    "deploy": "firebase deploy --only functions,firestore"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^1.5.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^22.10.0",
    "firebase": "^10.14.1",
    "typescript": "^5.6.3"
  }
}
