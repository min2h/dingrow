rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One save doc per Firebase user. Only the owner can read/write it.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'schema', 'summary', 'updatedAt'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000
        && request.resource.data.updatedAt == request.time;   // server timestamp only

      // Purchase credits are written ONLY by Cloud Functions (Admin SDK bypasses rules).
      match /credits/{token} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    // Global purchase-token ledger (dedup across accounts): server-only.
    match /purchases/{id} {
      allow read, write: if false;
    }
  }
}
